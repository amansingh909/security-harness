Screen {
    layout: vertical;
}

#status {
    height: 1;
    width: 100%;
    background: $panel;
    color: $text;
    padding: 0 1;
}

#sidebar {
    width: 34;
    border-right: solid $panel;
}

#main {
    width: 1fr;
}

.panel-title {
    text-style: bold;
    background: $panel;
    padding: 0 1;
    width: 100%;
}

#programs {
    height: 1fr;
}

#leads {
    height: 1fr;
}

#detail {
    height: 10;
    border-top: solid $panel;
    padding: 0 1;
    overflow-y: auto;
}

/* modal dialogs */
#dialog {
    align: center middle;
    width: 60;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: thick $primary;
}

#dialog-title {
    text-style: bold;
    padding-bottom: 1;
}

.form-section {
    text-style: bold;
    color: $text-muted;
}

.form-divider {
    color: $text-muted;
    text-align: center;
    width: 100%;
    padding: 1 0 0 0;
}

#dialog-buttons {
    height: auto;
    padding-top: 1;
    align-horizontal: right;
}

#dialog-buttons Button {
    margin-left: 2;
}

AddProgramScreen, PromptScreen, ConfirmScreen, HelpScreen {
    align: center middle;
}

/* dim the screen behind a modal so the dialog reads as on top */
ConfirmScreen, HelpScreen {
    background: $background 60%;
}

#help-dialog {
    width: 66;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: $surface;
    border: thick $primary;
}

#help-body {
    height: auto;
}
