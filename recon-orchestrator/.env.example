# --- authorized scope (REQUIRED — recon refuses to run without it) ---
RECON_TARGET=example.com
RECON_IN_SCOPE=example.com,*.example.com
RECON_OUT_OF_SCOPE=admin.example.com,legacy.example.com
# Or point at a file: RECON_SCOPE_FILE=./scope.yaml
RECON_ALLOW_MULTILEVEL_WILDCARD=true

# --- seeds to probe ---
RECON_SEEDS=www.example.com,api.example.com,dev.example.com
# RECON_SEEDS_FILE=./seeds.txt

# --- politeness (tune to the program's published rate limit; NOT evasion) ---
RECON_REQUESTS_PER_SECOND=2
RECON_MAX_CONCURRENCY=10
RECON_HTTP_TIMEOUT=15
RECON_USER_AGENT=recon-orchestrator/0.1 (authorized security testing)

# --- optional CVE correlation against a running cve-index ---
# RECON_CVE_INDEX_URL=http://localhost:8080

# --- output ---
# RECON_OUT_FILE=./candidates.json
RECON_LOG_LEVEL=INFO
RECON_LOG_JSON=true
